<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="warehouse_shelf">
    <static>false</static>
    <link name="shelf_link">
      <inertial>
        <pose>0 0 0.7 0 0 0</pose>
        <mass>18.0</mass>
        <inertia>
          <ixx>4.2</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.5</iyy><iyz>0</iyz>
          <izz>1.5</izz>
        </inertia>
      </inertial>

      <!-- 4 Corner Legs -->
      <!-- Front-Left Leg -->
      <visual name="leg_fl_vis">
        <pose>0.40 0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
        <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
      </visual>
      <collision name="leg_fl_col">
        <pose>0.40 0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
      </collision>

      <!-- Front-Right Leg -->
      <visual name="leg_fr_vis">
        <pose>0.40 -0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
        <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
      </visual>
      <collision name="leg_fr_col">
        <pose>0.40 -0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
      </collision>

      <!-- Rear-Left Leg -->
      <visual name="leg_rl_vis">
        <pose>-0.40 0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
        <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
      </visual>
      <collision name="leg_rl_col">
        <pose>-0.40 0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
      </collision>

      <!-- Rear-Right Leg -->
      <visual name="leg_rr_vis">
        <pose>-0.40 -0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
        <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
      </visual>
      <collision name="leg_rr_col">
        <pose>-0.40 -0.30 0.75 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.5</size></box></geometry>
      </collision>

      <!-- Lift Contact Deck (Underside engages with robot lift plate at z=0.27m) -->
      <visual name="lift_deck_vis">
        <pose>0 0 0.275 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.02</size></box></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <collision name="lift_deck_col">
        <pose>0 0 0.275 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.02</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
          </friction>
        </surface>
      </collision>

      <!-- Middle Shelf Tier -->
      <visual name="mid_shelf_vis">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.02</size></box></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <collision name="mid_shelf_col">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.02</size></box></geometry>
      </collision>

      <!-- Top Shelf Tier -->
      <visual name="top_shelf_vis">
        <pose>0 0 1.45 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.02</size></box></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <collision name="top_shelf_col">
        <pose>0 0 1.45 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.02</size></box></geometry>
      </collision>

      <!-- Storage Totes/Boxes on Shelves (Visual elements) -->
      <visual name="box1_vis">
        <pose>0.15 0.12 0.42 0 0 0</pose>
        <geometry><box><size>0.3 0.25 0.25</size></box></geometry>
        <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.7 0.45 0.2 1</diffuse></material>
      </visual>
      <visual name="box2_vis">
        <pose>-0.15 -0.12 0.42 0 0 0</pose>
        <geometry><box><size>0.3 0.25 0.25</size></box></geometry>
        <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.45 0.85 1</diffuse></material>
      </visual>
      <visual name="box3_vis">
        <pose>0 0 1.02 0 0 0</pose>
        <geometry><box><size>0.5 0.4 0.3</size></box></geometry>
        <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.7 0.45 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
