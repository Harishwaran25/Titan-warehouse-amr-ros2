<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_world">

    <!-- Physics Engine Configuration -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Overhead Ambient Lighting -->
    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.3 0.35 0.4 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main Directional Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- High-Bay Warehouse Ceiling Lights -->
    <light name="bay_light_1" type="point">
      <pose>-4 2 6 0 0 0</pose>
      <diffuse>0.7 0.7 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.03</linear><quadratic>0.005</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="bay_light_2" type="point">
      <pose>4 2 6 0 0 0</pose>
      <diffuse>0.7 0.7 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.03</linear><quadratic>0.005</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="bay_light_3" type="point">
      <pose>-4 -4 6 0 0 0</pose>
      <diffuse>0.7 0.7 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.03</linear><quadratic>0.005</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="bay_light_4" type="point">
      <pose>4 -4 6 0 0 0</pose>
      <diffuse>0.7 0.7 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.03</linear><quadratic>0.005</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.4 0.42 0.44 1</ambient>
            <diffuse>0.45 0.47 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- WAREHOUSE BOUNDARY WALLS -->
    <!-- North Wall -->
    <model name="north_wall">
      <static>true</static>
      <link name="link">
        <pose>0 8 2.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>20.4 0.4 4.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.4 4.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="south_wall">
      <static>true</static>
      <link name="link">
        <pose>0 -8 2.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>20.4 0.4 4.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.4 4.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="east_wall">
      <static>true</static>
      <link name="link">
        <pose>10 0 2.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.4 16.4 4.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 16.4 4.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="west_wall">
      <static>true</static>
      <link name="link">
        <pose>-10 0 2.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.4 16.4 4.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 16.4 4.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WAREHOUSE PALLET RACK ROWS -->
    <!-- Rack Row 1 (North Aisle Boundary) -->
    <model name="rack_row_1">
      <static>true</static>
      <link name="link">
        <pose>0 4.2 1.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>12.0 1.2 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12.0 1.2 3.0</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack Row 2 (Central Separator) -->
    <model name="rack_row_2">
      <static>true</static>
      <link name="link">
        <pose>0 0.8 1.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>12.0 1.2 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12.0 1.2 3.0</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack Row 3 (South Aisle Boundary) -->
    <model name="rack_row_3">
      <static>true</static>
      <link name="link">
        <pose>0 -2.6 1.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>12.0 1.2 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12.0 1.2 3.0</size></box></geometry>
          <material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- STAGING AREA OBSTACLES & STORAGE BOXES -->
    <!-- Staging Box Stack 1 -->
    <model name="cargo_crate_1">
      <static>true</static>
      <link name="link">
        <pose>6.5 -5.5 0.6 0 0 0.2</pose>
        <collision name="col"><geometry><box><size>1.4 1.2 1.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.4 1.2 1.2</size></box></geometry>
          <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.75 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Staging Box Stack 2 -->
    <model name="cargo_crate_2">
      <static>true</static>
      <link name="link">
        <pose>4.2 -6.0 0.5 0 0 -0.1</pose>
        <collision name="col"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.65 0.45 0.2 1</ambient><diffuse>0.7 0.5 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Barrels / Drums (Inspection target for vision camera) -->
    <model name="barrel_group">
      <static>true</static>
      <link name="b1">
        <pose>8.0 4.5 0.45 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.1 0.25 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="b2">
        <pose>8.0 5.2 0.45 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.8 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- AUTO-DOCKING & CHARGING STATION -->
    <!-- Positioned at x=-9.6, y=-5.5, facing East towards the charging corridor -->
    <include>
      <name>amr_charging_dock</name>
      <uri>model://charging_dock</uri>
      <pose>-9.6 -5.5 0 0 0 0</pose>
    </include>

    <!-- MOVABLE SHELF PODS FOR AMR LIFT TRANSPORT -->
    <!-- Shelf Pod 1 located in Aisle 1 (North corridor) -->
    <include>
      <name>warehouse_shelf_1</name>
      <uri>model://warehouse_shelf</uri>
      <pose>2.0 2.5 0 0 0 0</pose>
    </include>

    <!-- Shelf Pod 2 located in Aisle 2 (South corridor) -->
    <include>
      <name>warehouse_shelf_2</name>
      <uri>model://warehouse_shelf</uri>
      <pose>-2.0 -0.9 0 0 0 0</pose>
    </include>

  </world>
</sdf>
