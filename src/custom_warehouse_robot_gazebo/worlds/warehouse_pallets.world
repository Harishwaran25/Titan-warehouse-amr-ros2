    <!-- Warehouse_CeilingLight_003 removed (user preference); sun remains for ambient light -->

    <!-- ================= PALLET / STOCK STAGING (Titan extensions) =================
         Floor stacks + empty euro pallets for a real warehouse look.
         Placed in open lanes clear of AWS shelves / clutter. -->

    <!-- South staging row (loaded pallets) -->
    <include>
      <name>pallet_stack_s1</name>
      <uri>model://pallet_stack</uri>
      <pose>2.2 -7.2 0 0 0 0.05</pose>
    </include>
    <include>
      <name>pallet_stack_s2</name>
      <uri>model://pallet_stack</uri>
      <pose>3.6 -7.2 0 0 0 -0.08</pose>
    </include>
    <include>
      <name>pallet_stack_s3</name>
      <uri>model://pallet_stack</uri>
      <pose>5.0 -7.2 0 0 0 0.12</pose>
    </include>
    <include>
      <name>pallet_stack_s4</name>
      <uri>model://pallet_stack</uri>
      <pose>2.2 -8.6 0 0 0 -0.03</pose>
    </include>
    <include>
      <name>pallet_stack_s5</name>
      <uri>model://pallet_stack</uri>
      <pose>3.6 -8.6 0 0 0 0.1</pose>
    </include>

    <!-- West aisle stock line -->
    <include>
      <name>pallet_stack_w1</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.6 -4.5 0 0 0 1.57</pose>
    </include>
    <include>
      <name>pallet_stack_w2</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.6 -3.1 0 0 0 1.57</pose>
    </include>
    <include>
      <name>pallet_stack_w3</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.6 -1.7 0 0 0 1.57</pose>
    </include>
    <include>
      <name>pallet_stack_w4</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.6 -0.3 0 0 0 1.57</pose>
    </include>
    <include>
      <name>pallet_stack_w5</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.6 1.1 0 0 0 1.57</pose>
    </include>

    <!-- North bay stock -->
    <include>
      <name>pallet_stack_n1</name>
      <uri>model://pallet_stack</uri>
      <pose>1.2 7.0 0 0 0 0</pose>
    </include>
    <include>
      <name>pallet_stack_n2</name>
      <uri>model://pallet_stack</uri>
      <pose>2.6 7.0 0 0 0 0.15</pose>
    </include>
    <include>
      <name>pallet_stack_n3</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.4 6.2 0 0 0 1.57</pose>
    </include>
    <include>
      <name>pallet_stack_n4</name>
      <uri>model://pallet_stack</uri>
      <pose>-3.4 4.8 0 0 0 1.57</pose>
    </include>

    <!-- Extra mid-floor stacks near right shelves -->
    <include>
      <name>pallet_stack_e1</name>
      <uri>model://pallet_stack</uri>
      <pose>2.8 1.8 0 0 0 -0.2</pose>
    </include>
    <include>
      <name>pallet_stack_e2</name>
      <uri>model://pallet_stack</uri>
      <pose>2.8 0.4 0 0 0 0.05</pose>
    </include>
    <include>
      <name>pallet_stack_e3</name>
      <uri>model://pallet_stack</uri>
      <pose>2.8 -1.0 0 0 0 0.1</pose>
    </include>

    <!-- Empty euro pallets (movable) for forklift pickup demos -->
    <include>
      <name>euro_pallet_empty_1</name>
      <uri>model://euro_pallet</uri>
      <pose>0.5 -6.2 0.01 0 0 0</pose>
    </include>
    <include>
      <name>euro_pallet_empty_2</name>
      <uri>model://euro_pallet</uri>
      <pose>1.8 -6.2 0.01 0 0 0.2</pose>
    </include>
    <include>
      <name>euro_pallet_empty_3</name>
      <uri>model://euro_pallet</uri>
      <pose>-2.2 -5.5 0.01 0 0 1.57</pose>
    </include>
    <include>
      <name>euro_pallet_empty_4</name>
      <uri>model://euro_pallet</uri>
      <pose>0.8 4.5 0.01 0 0 -0.1</pose>
    </include>

    <!-- Charging dock kept from Titan layout (west wall area) -->
    <include>
      <name>amr_charging_dock</name>
      <uri>model://charging_dock</uri>
      <pose>-6.5 -9.0 0 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
