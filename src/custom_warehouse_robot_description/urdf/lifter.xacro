<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- LIFTER TOP CARGO BED -->
  <link name="lifter_plate">
    <!-- Main Top Load-Bearing Platform -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.46 0.02"/>
      </geometry>
      <material name="cargo_bed_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.46 0.02"/>
      </geometry>
    </collision>

    <!-- High-Grip Rubber Friction Pads (Front & Rear) -->
    <visual>
      <origin xyz="0.22 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.40 0.005"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
    <visual>
      <origin xyz="-0.22 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.40 0.005"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>

    <!-- Corner Alignment Guide Rollers -->
    <visual>
      <origin xyz="0.33 0.21 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0.33 -0.21 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.33 0.21 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.33 -0.21 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.02"/>
      </geometry>
      <material name="light_grey"/>
    </visual>

    <xacro:inertial_box mass="4.0" x="0.70" y="0.46" z="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- PRISMATIC JOINT FOR VERTICAL LIFT MECHANISM -->
  <joint name="lifter_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lifter_plate"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.06" effort="2000.0" velocity="0.05"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <gazebo reference="lifter_plate">
    <material>Gazebo/Grey</material>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>
