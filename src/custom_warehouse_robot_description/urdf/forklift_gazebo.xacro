<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel / caster contact materials -->
  <gazebo reference="left_wheel">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.8</mu1>
    <mu2>1.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.5</maxVel>
  </gazebo>

  <gazebo reference="right_wheel">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.8</mu1>
    <mu2>1.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.5</maxVel>
  </gazebo>

  <gazebo reference="caster_left">
    <material>Gazebo/Grey</material>
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="caster_right">
    <material>Gazebo/Grey</material>
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="chassis">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="fork_carriage">
    <material>Gazebo/Grey</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>

  <!-- Differential drive: track 0.48 m, wheel diameter 0.10 m -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.48</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>

      <!-- Encoder odom from joints (more consistent wheel "ticks"/integration) -->
      <max_wheel_torque>20.0</max_wheel_torque>
      <!-- 0 = apply target wheel speed immediately (avoids residual ramp creep) -->
      <max_wheel_acceleration>0.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <update_rate>50.0</update_rate>
      <!-- 1 = ENCODER (joint integration). More stable with AMCL while teleoping. -->
      <odometry_source>1</odometry_source>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50.0</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>fork_lift_joint</joint_name>
      <joint_name>caster_left_swivel_joint</joint_name>
      <joint_name>caster_right_swivel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Scan FOV matches config/lidar.yaml (90° → 270°) -->
  <xacro:property name="lidar_samples" value="360"/>
  <xacro:property name="lidar_min_angle" value="${pi/2}"/>
  <xacro:property name="lidar_max_angle" value="${3.0 * pi / 2.0}"/>
  <xacro:property name="lidar_range_min" value="0.40"/>
  <xacro:property name="lidar_range_max" value="25.0"/>
  <xacro:property name="lidar_update_rate" value="15.0"/>

  <gazebo reference="lidar_link">
    <sensor name="laser_scanner" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${lidar_update_rate}</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_min_angle}</min_angle>
            <max_angle>${lidar_max_angle}</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- Keep min range above robot body to avoid self-hits as false obstacles -->
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
